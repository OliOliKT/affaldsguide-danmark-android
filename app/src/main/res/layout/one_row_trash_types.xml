<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="74dp"
    android:padding="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/affaldsfraktionBillede"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="3dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/rounded_corner_mini"/>

    <TextView
        android:id="@+id/affaldsfraktionNavn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:textSize="20sp"
        android:textColor="@color/text_color"
        android:textStyle="normal"
        app:layout_constraintStart_toEndOf="@id/affaldsfraktionBillede"
        app:layout_constraintTop_toTopOf="@id/affaldsfraktionBillede" />

    <ImageView
        android:id="@+id/clickIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="26dp"
        android:src="@drawable/arrow_right"
        app:tint="@color/text_color"
        app:layout_constraintBottom_toBottomOf="@id/affaldsfraktionNavn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/affaldsfraktionNavn" />

</androidx.constraintlayout.widget.ConstraintLayout>

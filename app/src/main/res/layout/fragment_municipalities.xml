<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <com.google.android.ads.nativetemplates.TemplateView
        android:id="@+id/my_template"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:gnt_template_type="@layout/gnt_small_template_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/municipalitiesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:text="@string/kommuner"
        android:textColor="@color/green_light"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_goneMarginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/my_template" />

    <TextView
        android:id="@+id/municipalitiesIntro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/kommuner_intro"
        android:textColor="@color/text_color"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/municipalitiesHeader" />

    <EditText
        android:id="@+id/searchMunicipalityInput"
        style="@style/MultiAutoCompleteTextViewStyle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:autofillHints=""
        android:background="@drawable/x_background"
        android:hint="@string/indtast_kommune"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textColorHint="@color/grey_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/municipalitiesIntro" />

    <TextView
        android:id="@+id/emptyMunicipalitiesText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="22dp"
        android:text="@string/kommuner_kunne_ikke_indlaeses"
        android:textColor="@color/text_color"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchMunicipalityInput" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listMunicipalities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchMunicipalityInput" />

</androidx.constraintlayout.widget.ConstraintLayout>

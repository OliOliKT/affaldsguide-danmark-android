<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/photoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_color"
        android:textSize="22sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">
        <com.simpleweb.affaldsguidedanmark.PhotoSelectionView
            android:id="@+id/photoSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:id="@+id/photoLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/search_group_background"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone">
            <ProgressBar
                android:id="@+id/photoLoadingSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/green_light" />
            <TextView
                android:id="@+id/photoLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_color"
                android:textSize="14sp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/photoHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:textColor="@color/text_color"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/photoResultsHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_color"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/photoResultsNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/grey_black"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/photoCandidates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/analyzeSelection"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/photo_search_primary_button"
        android:backgroundTint="@null"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:visibility="gone" />

    <Button
        android:id="@+id/analyzeFullImage"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/photo_search_primary_button"
        android:backgroundTint="@null"
        android:textColor="@color/white"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/replacePhotoButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/photo_search_primary_button"
        android:backgroundTint="@null"
        android:textColor="@color/white"
        android:textAllCaps="false" />
</LinearLayout>
